# surge — lightweight VLESS+Reality+Vision + optional gost automation stack
# Shared desired state (committed to git).
# Node-specific overrides live in nodes/<node>.env (selected via .node or CLI).
# Secrets and ad-hoc per-node overrides live in .env (gitignored; auto-generated by scripts/bootstrap.sh).

# ---------------------------------------------------------------------------
# Default Node Identity & Ports (overridden by nodes/<node>.env or .env)
# ---------------------------------------------------------------------------
NODE_NAME=surge1
DISPLAY_NAME=
NODE_HOST=surge1.aichorage.de
DOMAIN_NAME=aichorage.de
SSH_TARGET=

# Public client port (mapped on NAT gateway to VLESS_LISTEN_PORT, or direct port)
PUBLIC_VLESS_PORT=443
# Internal TCP port that Xray binds inside the VPS/container
VLESS_LISTEN_PORT=443

# Remove legacy hysteria init/systemd units if present on NAT nodes
CLEANUP_LEGACY_HYSTERIA=0

# ---------------------------------------------------------------------------
# Xray / VLESS + Reality + XTLS-Vision Settings
# ---------------------------------------------------------------------------
# Pinned xray-core version. >= 26.7.11 defaults minClientVer to 26.3.27 and
# >= 26.9.x mandates ML-KEM ClientHellos, which rejects mihomo v1.19.x clients.
XRAY_VERSION=v26.6.27

# Reality camouflage target (must support TLS 1.3 + H2 without redirects).
REALITY_DEST=www.apple.com:443
REALITY_SNI=www.apple.com
REALITY_SERVER_NAMES=
REALITY_FINGERPRINT=chrome
REALITY_MIN_CLIENT_VER=1.8.2
REALITY_MAX_TIME_DIFF=60000
REALITY_SHORT_IDS=a3f1,be42

VLESS_EMAIL=user@aichorage.de

# TCP socket tuning for NAT traversal & dead-peer detection
TCP_KEEPALIVE_IDLE=30
TCP_KEEPALIVE_INTERVAL=15
TCP_USER_TIMEOUT=30000

# ---------------------------------------------------------------------------
# Optional gost TCP/UDP Forwarder (default: disabled)
# ---------------------------------------------------------------------------
GOST_ENABLE=0
GOST_VERSION=v3.3.0

# Internal default port that gost binds inside the VPS/container
GOST_LISTEN_PORT=80

# Upstream forwarding targets: single "host:port", "[listen_port/]host:port",
# or comma/space-separated list of targets. Leave empty to skip that protocol.
GOST_FORWARD_TCP=
GOST_FORWARD_UDP=
GOST_EXTRA_ARGS=

# Optional relay front-end metadata (set on an upstream node fronted by a gost relay)
PUBLIC_RELAY_NAME=
PUBLIC_RELAY_HOST=
PUBLIC_RELAY_PORT=
