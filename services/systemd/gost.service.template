[Unit]
Description=GO Simple Tunnel (gost Relay)
Documentation=https://gost.run/
After=network.target network-online.target nss-lookup.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Environment="GOGC=${GOGC}"
Environment="GOMAXPROCS=${GOMAXPROCS}"
Environment="GOMEMLIMIT=${GOST_GOMEMLIMIT}"
ExecStartPre=-/sbin/sysctl -q -p /etc/sysctl.d/99-bbr.conf
ExecStart=/usr/local/bin/gost -C /etc/gost/config.json
Restart=always
RestartSec=2s
LimitNOFILE=65535
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
