{
  "log": {
    "access": "none",
    "dnsLog": false,
    "loglevel": "warning"
  },
  "dns": {
    "hosts": {
      "www.gstatic.com": [
        "142.251.157.120",
        "142.251.155.120",
        "142.251.156.120",
        "142.251.154.120"
      ],
      "cp.cloudflare.com": [
        "1.1.1.1",
        "1.0.0.1"
      ],
      "www.google.com": [
        "142.251.157.100",
        "142.251.155.100"
      ],
      "www.yahoo.com": [
        "74.6.231.20",
        "74.6.231.21",
        "98.137.11.163",
        "98.137.11.164"
      ]
    },
    "servers": [
      "1.1.1.1",
      "8.8.8.8",
      "localhost"
    ],
    "queryStrategy": "UseIPv4",
    "enableParallelQuery": true,
    "serveStale": true,
    "serveExpiredTTL": 86400,
    "cacheStrategy": "CacheOnDemand"
  },
  "policy": {
    "levels": {
      "0": {
        "handshake": 20,
        "connIdle": 300,
        "uplinkOnly": 6,
        "downlinkOnly": 10,
        "bufferSize": 256
      }
    }
  },
  "inbounds": [
    {
      "tag": "in-vless-reality",
      "listen": "0.0.0.0",
      "port": ${VLESS_LISTEN_PORT},
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "${VLESS_UUID}",
            "flow": "xtls-rprx-vision",
            "email": "${VLESS_EMAIL}"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "${REALITY_DEST}",
          "xver": 0,
          "serverNames": ${REALITY_SERVER_NAMES_JSON},
          "privateKey": "${REALITY_PRIVATE_KEY}",
          "minClientVer": "${REALITY_MIN_CLIENT_VER}",
          "maxTimeDiff": ${REALITY_MAX_TIME_DIFF},
          "shortIds": ${REALITY_SHORT_IDS_JSON}
        },
        "sockopt": {
          "tcpFastOpen": false,
          "tcpCongestion": "bbr",
          "tcpKeepAliveIdle": ${TCP_KEEPALIVE_IDLE},
          "tcpKeepAliveInterval": ${TCP_KEEPALIVE_INTERVAL}
        }
      },
      "sniffing": {
        "enabled": false
      }
    }${RELAY_INBOUND_JSON}
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "UseIPv4"
      },
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "UseIPv4",
          "tcpFastOpen": false,
          "tcpCongestion": "bbr",
          "tcpKeepAliveIdle": ${TCP_KEEPALIVE_IDLE},
          "tcpKeepAliveInterval": ${TCP_KEEPALIVE_INTERVAL}
        }
      }
    },
    {
      "tag": "blocked",
      "protocol": "blackhole",
      "settings": {}
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      ${RELAY_ROUTING_RULE_JSON}
      ${BLOCKED_UDP_RULE}
      {
        "type": "field",
        "ip": ${BLOCKED_IPS_JSON},
        "outboundTag": "blocked"
      },
      {
        "type": "field",
        "protocol": [
          "bittorrent"
        ],
        "outboundTag": "blocked"
      }
    ]
  }
}
