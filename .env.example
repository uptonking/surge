# Secrets and optional per-node overrides for a surge node.
# Copy to .env (gitignored) or let scripts/bootstrap.sh generate it automatically.
VLESS_UUID=
REALITY_PRIVATE_KEY=
REALITY_PUBLIC_KEY=
HYSTERIA_PASSWORD=
# Optional Cloudflare DNS API token for automatic ACME DNS-01 certs when HYSTERIA_ENABLE=1:
# HYSTERIA_CF_DNS_TOKEN=

# Optional ad-hoc VPS overrides (when deploying without a nodes/<node>.env file):
# NODE_NAME=surge4
# NODE_HOST=surge4.aichorage.de
# PUBLIC_VLESS_PORT=23141
# VLESS_LISTEN_PORT=443
# HYSTERIA_ENABLE=0
# PUBLIC_HYSTERIA_PORT=23142
# HYSTERIA_LISTEN_PORT=80
# GOST_ENABLE=0
