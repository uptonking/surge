# Node profile: surge1 (Debian 13 NAT/LXC)
# Public ports: 23110 -> 22/tcp, 23111 -> 443/tcp, 23112 -> 80/tcp,udp
NODE_NAME=surge1
DISPLAY_NAME=Surge1
NODE_HOST=surge1.aichorage.de
SSH_TARGET=surge1
XRAY_ENABLE=1
PUBLIC_VLESS_PORT=23111
VLESS_LISTEN_PORT=443
CLEANUP_LEGACY_HYSTERIA=1

# Disable UDP outbound on NAT/LXC nodes with poor vendor UDP support
UDP_DISABLE=1

# Relaxed memory limits for 512MB RAM container
XRAY_GOMEMLIMIT=320MiB
GOST_GOMEMLIMIT=320MiB

# Enable gost forwarding on surge1 (surge1-relay.aichorage.de:23112 -> verge2.aichorage.de)
# Pure TCP forwarding only - no UDP forward to prevent NAT gateway stalls
GOST_ENABLE=1
GOST_LISTEN_PORT=80
GOST_FORWARD_TCP=verge2.aichorage.de:8443
GOST_FORWARD_UDP=
