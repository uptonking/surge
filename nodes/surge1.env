# Node profile: surge1 (Debian 13 NAT/LXC)
# Public ports: 23110 -> 22/tcp, 23111 -> 443/tcp, 23112 -> 80/tcp,udp
NODE_NAME=surge1
DISPLAY_NAME=Surge1
NODE_HOST=surge1.aichorage.de
SSH_TARGET=surge1
XRAY_ENABLE=1
PUBLIC_VLESS_PORT=23111
VLESS_LISTEN_PORT=443
CLEANUP_LEGACY_HYSTERIA=1

# Disable UDP outbound on NAT/LXC nodes with poor vendor UDP support
UDP_DISABLE=1

# Memory limits for 512MB RAM Debian container (Gost eliminated, Xray given full headroom)
XRAY_GOMEMLIMIT=256MiB
GOGC=50

# Native Xray dokodemo-door TCP relay on port 80 (public port 23112 -> 80/tcp)
# Relays directly to verge2 (166.88.160.139:8443) using Linux kernel splice(2) zero-copy
RELAY_ENABLE=1
RELAY_LISTEN_PORT=80
RELAY_FORWARD=166.88.160.139:8443

# gost disabled on surge1 in favor of native zero-overhead Xray relay
GOST_ENABLE=0
GOST_LISTEN_PORT=80
GOST_FORWARD_TCP=
GOST_FORWARD_UDP=
