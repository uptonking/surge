# Node profile: verge2 (worker_2 Ubuntu 24.04 dedicated IP)
# Listens on 8443/tcp so both direct verge2.aichorage.de:8443 and
# surge1-relay.aichorage.de:23112 (gost TCP -> verge2.aichorage.de:8443) work,
# alongside existing Verge2-Hy2 on 443/udp.
NODE_NAME=verge2
NODE_HOST=verge2.aichorage.de
PUBLIC_VLESS_PORT=8443
VLESS_LISTEN_PORT=8443

# Also emit the surge1-relay link in client.sh when run on verge2
PUBLIC_RELAY_HOST=surge1-relay.aichorage.de
PUBLIC_RELAY_PORT=23112

GOST_ENABLE=0
