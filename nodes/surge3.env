# Node profile: surge3 (Alpine 3.23 NAT/LXC)
# Public ports: 23130 -> 22/tcp, 23131 -> 443/tcp, 23132 -> 80/tcp,udp
NODE_NAME=surge3
DISPLAY_NAME=Surge3
NODE_HOST=surge3.aichorage.de
SSH_TARGET=surge3
XRAY_ENABLE=1
PUBLIC_VLESS_PORT=23131
VLESS_LISTEN_PORT=443
CLEANUP_LEGACY_HYSTERIA=1

# Disable UDP outbound on NAT/LXC nodes with poor vendor UDP support
UDP_DISABLE=1

# Memory limits for 256MB Alpine container
XRAY_GOMEMLIMIT=160MiB
GOST_GOMEMLIMIT=64MiB
GOGC=50

# Pre-wired for future gost relay/proxying on public port 23132 -> internal :80
GOST_ENABLE=0
GOST_LISTEN_PORT=80
GOST_FORWARD_TCP=verge2.aichorage.de:8443
GOST_FORWARD_UDP=
# Or use raw gost v3 rules/chains:
# GOST_RULES="-L tcp://:80/target.example.com:443"
