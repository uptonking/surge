# Node profile: verge4 (worker_4 Ubuntu 24.04 dedicated IP 23.94.147.21)
# Listens on 8443/tcp so both direct verge4.aichorage.de:8443 and
# stash1-relay.aichorage.de:23112 (gost TCP -> verge4.aichorage.de:8443) work,
# alongside existing Verge4-Hy2 on 443/udp.
NODE_NAME=verge4
DISPLAY_NAME=Verge4
NODE_HOST=verge4.aichorage.de
SSH_TARGET=root@23.94.147.21
PUBLIC_VLESS_PORT=8443
VLESS_LISTEN_PORT=8443
CLEANUP_LEGACY_HYSTERIA=0

# Emit the Stash1-Relay link in client.sh when run on verge4
PUBLIC_RELAY_NAME=Stash1-Relay
PUBLIC_RELAY_HOST=stash1-relay.aichorage.de
PUBLIC_RELAY_PORT=23112

XRAY_ENABLE=1
HYSTERIA_ENABLE=0
GOST_ENABLE=0
