# Node profile: surge (Debian 12 LXC on 154.23.172.251)
# Direct public IP on eth0, all ports exposed natively.
NODE_NAME=surge
DISPLAY_NAME=Surge
NODE_HOST=surge.aichorage.de
SSH_TARGET=surge
CLEANUP_LEGACY_HYSTERIA=0

# Relaxed memory limits for 256MB container
XRAY_GOMEMLIMIT=180MiB
HYSTERIA_GOMEMLIMIT=180MiB

# VLESS + Reality + Vision on standard 443/tcp
XRAY_ENABLE=1
PUBLIC_VLESS_PORT=443
VLESS_LISTEN_PORT=443

# Hysteria2 on standard 443/udp + port hopping across 20000-30000/udp -> 443/udp
HYSTERIA_ENABLE=1
PUBLIC_HYSTERIA_PORT=443
HYSTERIA_LISTEN_PORT=443
HYSTERIA_HOP_PORTS=20000-30000
HYSTERIA_HOP_INTERVAL=30

# gost proxying disabled on this node (enableable whenever needed)
GOST_ENABLE=0
GOST_LISTEN_PORT=80
GOST_FORWARD_TCP=
GOST_FORWARD_UDP=
