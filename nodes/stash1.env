# Node profile: stash1 (Debian 12 NAT/LXC on 156.238.254.181)
# Public ports: 23110 -> 22/tcp, 23111 -> 443/tcp, 23112 -> 80/tcp,udp, 23116-23119 -> 23116-23119/udp
NODE_NAME=stash1
DISPLAY_NAME=Stash1
NODE_HOST=stash1.aichorage.de
SSH_TARGET=stash1
CLEANUP_LEGACY_HYSTERIA=0

# VLESS + Reality + Vision on 23111 -> 443/tcp
XRAY_ENABLE=1
PUBLIC_VLESS_PORT=23111
VLESS_LISTEN_PORT=443

# Hysteria2 on 23116/udp -> 80/udp + port hopping on 23116-23119/udp -> 80/udp (4 ports)
HYSTERIA_ENABLE=1
PUBLIC_HYSTERIA_PORT=23116
HYSTERIA_LISTEN_PORT=80
HYSTERIA_HOP_PORTS=23116-23119
HYSTERIA_HOP_INTERVAL=30

# Disable UDP outbound on NAT/LXC nodes with poor vendor UDP support
UDP_DISABLE=1

# Memory limits for 488MB RAM Debian container (Gost eliminated, saving ~35MB RSS / 1.4GB virtual)
XRAY_GOMEMLIMIT=160MiB
HYSTERIA_GOMEMLIMIT=96MiB
GOGC=50

# Native Xray dokodemo-door TCP relay on 23112/tcp -> 80/tcp -> verge4 (23.94.147.21:8443)
# (UDP :80 is dedicated to Hysteria2; TCP :80 is dedicated to native Xray relay)
RELAY_ENABLE=1
RELAY_LISTEN_PORT=80
RELAY_FORWARD=23.94.147.21:8443

# gost disabled on stash1 in favor of native zero-overhead Xray relay
GOST_ENABLE=0
GOST_LISTEN_PORT=80
GOST_FORWARD_TCP=
GOST_FORWARD_UDP=
