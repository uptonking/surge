# Node profile: stash1 (Debian 12 NAT/LXC on 156.238.254.181)
# Public ports: 23110 -> 22/tcp, 23111 -> 443/tcp, 23112 -> 80/tcp,udp, 23116-23119 -> 23116-23119/udp
NODE_NAME=stash1
DISPLAY_NAME=Stash1
NODE_HOST=stash1.aichorage.de
SSH_TARGET=stash1
CLEANUP_LEGACY_HYSTERIA=0

# VLESS + Reality + Vision on 23111 -> 443/tcp
XRAY_ENABLE=1
PUBLIC_VLESS_PORT=23111
VLESS_LISTEN_PORT=443

# Hysteria2 on 23112/udp -> 80/udp + port hopping on 23116-23119/udp -> 80/udp
HYSTERIA_ENABLE=1
PUBLIC_HYSTERIA_PORT=23112
HYSTERIA_LISTEN_PORT=80
HYSTERIA_HOP_PORTS=23116-23119
HYSTERIA_HOP_INTERVAL=30

# gost TCP forwarding on 23112/tcp -> 80/tcp -> verge4.aichorage.de:8443
# (UDP :80 is dedicated to Hysteria2; TCP :80 is dedicated to gost relay)
GOST_ENABLE=1
GOST_LISTEN_PORT=80
GOST_FORWARD_TCP=verge4.aichorage.de:8443
GOST_FORWARD_UDP=
