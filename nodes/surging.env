# Node profile: surging (Debian 13 NAT/LXC on 161.114.15.64)
# Public ports: 23100 -> 22/tcp, 23101 -> 443/tcp, 23102 -> 80/tcp,udp
NODE_NAME=surging
DISPLAY_NAME=Surging
NODE_HOST=surging.aichorage.de
SSH_TARGET=surging
CLEANUP_LEGACY_HYSTERIA=1

# Disable UDP outbound on NAT/LXC nodes with poor vendor UDP support
UDP_DISABLE=1

# Memory limits for 512MB RAM Debian container
XRAY_GOMEMLIMIT=200MiB
GOST_GOMEMLIMIT=96MiB
GOGC=50

# VLESS + Reality + Vision on 23101 -> 443/tcp (default enabled)
XRAY_ENABLE=1
PUBLIC_VLESS_PORT=23101
VLESS_LISTEN_PORT=443

# Optional Hysteria2 QUIC service (disabled by default on surging, enableable if desired)
HYSTERIA_ENABLE=0
PUBLIC_HYSTERIA_PORT=23102
HYSTERIA_LISTEN_PORT=80

# gost enabled by default on surging (Public port 23102 -> internal :80)
# Relays to verge2.aichorage.de:8443
GOST_ENABLE=1
GOST_LISTEN_PORT=80
GOST_FORWARD_TCP=verge2.aichorage.de:8443
GOST_FORWARD_UDP=
