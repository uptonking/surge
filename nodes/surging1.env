# Node profile: surging1 (Debian 13 NAT/LXC on 161.114.15.64)
# Public ports: 23190 -> 22/tcp, 23191 -> 443/tcp, 23192 -> 80/tcp,udp
NODE_NAME=surging1
DISPLAY_NAME=Surging1
NODE_HOST=surging1.aichorage.de
SSH_TARGET=surging1
CLEANUP_LEGACY_HYSTERIA=1

# Disable UDP outbound on NAT/LXC nodes with poor vendor UDP support
UDP_DISABLE=1

# Memory limits for 512MB RAM Debian container (Xray 200MiB, gost 96MiB)
XRAY_GOMEMLIMIT=200MiB
GOST_GOMEMLIMIT=96MiB
GOGC=50

# VLESS + Reality + Vision on 23191 -> 443/tcp (default enabled)
XRAY_ENABLE=1
PUBLIC_VLESS_PORT=23191
VLESS_LISTEN_PORT=443

# Optional Hysteria2 QUIC service (disabled by default on surging1, enableable if desired)
HYSTERIA_ENABLE=0
PUBLIC_HYSTERIA_PORT=23192
HYSTERIA_LISTEN_PORT=80

# gost forwarding enabled by default on surging1 (Public port 23192 -> internal :80)
# Relays to verge2.aichorage.de:8443
GOST_ENABLE=1
GOST_LISTEN_PORT=80
GOST_FORWARD_TCP=verge2.aichorage.de:8443
GOST_FORWARD_UDP=

# Native dokodemo-door relay disabled when gost is active
RELAY_ENABLE=0
RELAY_LISTEN_PORT=80
RELAY_FORWARD=166.88.160.139:8443
