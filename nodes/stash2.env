# Node profile: stash2 (Debian 12 NAT/LXC on 156.238.254.181)
# Public ports: 23120 -> 22/tcp, 23121 -> 443/tcp, 23126-23129 -> 23126-23129/udp
NODE_NAME=stash2
DISPLAY_NAME=Stash2
NODE_HOST=stash2.aichorage.de
SSH_TARGET=stash2
CLEANUP_LEGACY_HYSTERIA=0

# VLESS + Reality + Vision on 23121 -> 443/tcp
XRAY_ENABLE=1
PUBLIC_VLESS_PORT=23121
VLESS_LISTEN_PORT=443

# Hysteria2 on 23126/udp -> 80/udp + port hopping on 23126-23129/udp -> 80/udp (4 ports)
HYSTERIA_ENABLE=1
PUBLIC_HYSTERIA_PORT=23126
HYSTERIA_LISTEN_PORT=80
HYSTERIA_HOP_PORTS=23126-23129
HYSTERIA_HOP_INTERVAL=30

# Disable UDP outbound on NAT/LXC nodes with poor vendor UDP support
UDP_DISABLE=1

# Memory limits for 488MB RAM Debian container
XRAY_GOMEMLIMIT=160MiB
HYSTERIA_GOMEMLIMIT=96MiB
GOGC=50

# gost disabled on stash2
GOST_ENABLE=0
GOST_LISTEN_PORT=80
GOST_FORWARD_TCP=
GOST_FORWARD_UDP=
